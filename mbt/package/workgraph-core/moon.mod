license = "MIT"

keywords = [
  "agent",
  "graph",
  "runtime",
  "moonbit",
]

description = "Runtime-independent asynchronous graph compiler and runtime"

import {
  "Yoorkin/any@0.2.1",
  "moonbitlang/async@0.20.3",
  "moonbitlang/x@0.4.47",
  "totto2727/any-collection@0.2.0",
}

supported_targets = "+native+js"

source = "src"
